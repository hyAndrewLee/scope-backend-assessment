# Server-only settings. Use .env.local; never commit credentials.
DATABASE_URL=
# Optional hosted provider public CA, PEM or literal \n escapes.
DATABASE_SSL_CA=
APP_ORIGIN=http://localhost:3000
# Generate: bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
PREVIEW_SIGNING_SECRET=
GEMINI_API_KEY=
# Verify this model is available to your Google project; no silent fallback.
GEMINI_MODEL=gemini-2.5-flash
