{
  "name": "scope-movie-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "db:check": "bun --conditions=react-server scripts/check-database.ts",
    "db:seed": "bun --conditions=react-server scripts/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.105",
    "@tanstack/react-query": "^5.90.0",
    "ai": "7.0.153",
    "axios": "^1.13.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "next": "^15.5.0",
    "postgres": "3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/bun": "^1.2.23",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}
